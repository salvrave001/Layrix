    <Page Include="src\editor\TemplateCard.xaml" />
    <Page Include="src\editor\CanvasEditor.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="2.0.250303.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="LayrixCore.vcxproj">
      <Project>{C4A1E7B2-6D34-4F18-9A55-2B8E0D1C7F63}</Project>
    </ProjectReference>
  </ItemGroup>
  <Target Name="AddProcessedXamlFilesToCopyLocal" />
  <Target Name="EnsureXamlBinary" BeforeTargets="_GenerateProjectPriConfigurationFiles" DependsOnTargets="MarkupCompilePass2" />
  <Target Name="GenerateXamlConnections" BeforeTargets="ClCompile" DependsOnTargets="MarkupCompilePass1;MarkupCompilePass2" />
  <Target Name="AddWinUIXamlReferences" BeforeTargets="MarkupCompilePass1">
    <ItemGroup>
      <ReferencePath Include="$(PkgMicrosoft_WindowsAppSDK)\lib\uap10.0\*.winmd">
        <WinMDFile>true</WinMDFile>
      </ReferencePath>
      <ReferencePath Include="$(PkgMicrosoft_WindowsAppSDK)\lib\uap10.0.18362\*.winmd">
        <WinMDFile>true</WinMDFile>
      </ReferencePath>
      <ReferencePath Include="$(WindowsSdkDir)UnionMetadata\$(WindowsTargetPlatformVersion)\Windows.winmd">
        <WinMDFile>true</WinMDFile>
      </ReferencePath>
      <ReferencePath Include="$(WindowsSdkDir)References\$(WindowsTargetPlatformVersion)\Windows.Foundation.FoundationContract\*\Windows.Foundation.FoundationContract.winmd">
        <WinMDFile>true</WinMDFile>
      </ReferencePath>
      <ReferencePath Include="$(WindowsSdkDir)References\$(WindowsTargetPlatformVersion)\Windows.Foundation.UniversalApiContract\*\Windows.Foundation.UniversalApiContract.winmd">
        <WinMDFile>true</WinMDFile>
      </ReferencePath>
    </ItemGroup>
  </Target>
  <Target Name="AddWinUIXamlPass2References" BeforeTargets="MarkupCompilePass2">
    <PropertyGroup>
      <FacadeWinmdPath>$(WindowsSdkDir)UnionMetadata\$(WindowsTargetPlatformVersion)\Facade\unused.winmd</FacadeWinmdPath>
    </PropertyGroup>
    <ItemGroup>
      <WinMDReferenceToCompile Include="$(PkgMicrosoft_WindowsAppSDK)\lib\uap10.0\*.winmd" />
      <WinMDReferenceToCompile Include="$(PkgMicrosoft_WindowsAppSDK)\lib\uap10.0.18362\*.winmd" />
      <WinMDReferenceToCompile Include="$(WindowsSdkDir)References\$(WindowsTargetPlatformVersion)\**\*.winmd" />
      <WinMDReferenceToCompile Include="$(TargetDir)LayrixEditor.winmd" />
    </ItemGroup>
  </Target>
  <Target Name="AddWinUIFrameworkPri" BeforeTargets="_GetPriFilesFromPayload">
    <ItemGroup>
      <PackagingOutputs Include="$(IntermediateOutputPath)MsixContent\Microsoft.UI.Xaml.Controls.pri">
        <ProjectName>Microsoft.UI.Xaml.Controls</ProjectName>
        <OutputGroup>Content</OutputGroup>
      </PackagingOutputs>
      <PackagingOutputs Include="$(IntermediateOutputPath)MsixContent\Microsoft.UI.pri">
        <ProjectName>Microsoft.UI</ProjectName>
        <OutputGroup>Content</OutputGroup>
      </PackagingOutputs>
    </ItemGroup>
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
