    <ClInclude Include="src\editor\EditorWindow.xaml.h" />
    <ClInclude Include="src\editor\TemplateCard.xaml.h" />
    <ClInclude Include="src\editor\CanvasEditor.xaml.h" />
    <ClInclude Include="src\editor\DesktopZoneEditor.h" />
    <ClInclude Include="src\editor\ColorPickerWindow.h" />
    <ClInclude Include="src\editor\XamlMetaDataProvider.h" />
  </ItemGroup>
  <ItemGroup>
    <Midl Include="src\editor\App.idl" />
    <Midl Include="src\editor\EditorWindow.idl" />
    <Midl Include="src\editor\TemplateCard.idl" />
    <Midl Include="src\editor\CanvasEditor.idl" />
  </ItemGroup>
  <ItemGroup>
