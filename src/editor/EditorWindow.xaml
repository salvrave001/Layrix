<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="LayrixEditor.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Layrix — Редактор зон">
    <Grid x:Name="Root" Background="Transparent" RequestedTheme="Dark">
        <Grid.Resources>
            <AcrylicBrush x:Key="GlassBrush" TintColor="#1A1A1A" TintOpacity="0.22" FallbackColor="#73202020"/>
            <AcrylicBrush x:Key="GlassSoftBrush" TintColor="#121212" TintOpacity="0.12" FallbackColor="#40141414"/>
            <SolidColorBrush x:Key="GlassStroke" Color="#33FFFFFF"/>
            <SolidColorBrush x:Key="DarkButtonFill" Color="#E62B2B2B"/>
            <Style x:Key="DarkPillButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DarkButtonFill}"/>
                <Setter Property="Foreground" Value="#FFF3F3F3"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Height" Value="36"/>
            </Style>
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="20"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="TitleDrag" Background="Transparent" Margin="0,0,208,0">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                <FontIcon x:Name="TitleIcon" Glyph="&#xE8A9;" FontSize="14" Foreground="#FFE5E5E5"/>
                <TextBlock Text="Layrix" FontSize="12" Foreground="#FFE5E5E5" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Button x:Name="SettingsButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,156,0" Width="36" Height="32" Padding="0"
                Background="#CC2B2B2B" BorderBrush="#33FFFFFF" BorderThickness="1"
                CornerRadius="16" ToolTipService.ToolTip="Настройки">
            <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="#FFE8E8E8"/>
        </Button>
        <Border x:Name="MonitorSection" Grid.Row="1" Background="{StaticResource GlassSoftBrush}"
                BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <StackPanel x:Name="MonitorHost" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12"/>
                <TextBlock x:Name="MonitorDescription" FontSize="12" Foreground="#FFAAAAAA" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="Gallery" Grid.Row="2" Background="Transparent" VerticalScrollBarVisibility="Auto" Padding="24,20,24,12">
            <StackPanel Spacing="14">
                <TextBlock Text="Шаблоны" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TemplateHost" Orientation="Horizontal" Spacing="10"/>
                </ScrollViewer>
                <TextBlock Text="Свои макеты" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,0"/>
                <Border x:Name="CustomEmpty" Style="{StaticResource GlassCard}" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Ваше рабочее пространство" Foreground="#FFDDDDDD" FontSize="14"/>
                        <TextBlock Text="Создайте макет и расположите зоны так, как удобно вам." Foreground="#FF999999" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CustomHost" Orientation="Horizontal" Spacing="10"/>
                </ScrollViewer>
                <Expander Header="Настройки привязки" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
                    <StackPanel x:Name="ControlsHost" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="SpacingLabel" Text="Отступ" Foreground="White" VerticalAlignment="Center" MinWidth="180"/>
                            <TextBlock x:Name="SpacingValue" MinWidth="42" Foreground="#FFBBBBBB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Перехват Win + стрелки" Foreground="White" VerticalAlignment="Center" MinWidth="180"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Background="Transparent" Padding="32,24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="850" HorizontalAlignment="Stretch" Spacing="20">
                <Button x:Name="BackToLayouts" Style="{StaticResource DarkPillButton}" Content="←  К макетам зон" HorizontalAlignment="Left"/>
                <TextBlock Text="Настройки приложения" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Изменения применяются сразу." Foreground="#FFAAAAAA"/>
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="10">
                        <ToggleSwitch x:Name="StartupToggle" Header="Запускать вместе с Windows" OnContent="Включён" OffContent="Выключен"/>
                        <TextBlock Text="Layrix будет запускаться при входе в вашу учётную запись и работать в трее. Окно редактора открываться не будет." TextWrapping="Wrap" Foreground="#FFBBBBBB"/>
                        <TextBlock x:Name="StartupStatus" TextWrapping="Wrap" Foreground="#FFAAAAAA" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="10">
                        <ToggleSwitch x:Name="ZonesToggle" Header="Привязка окон к зонам" OnContent="Включена" OffContent="Выключена"/>
                        <TextBlock x:Name="ZonesSnapHint" TextWrapping="Wrap" Foreground="#FFBBBBBB"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Клавиша привязки" Foreground="White" VerticalAlignment="Center" MinWidth="140"/>
                            <Button x:Name="SnapHoldButton" Style="{StaticResource DarkPillButton}" MinWidth="140"/>
                            <Button x:Name="SnapHoldReset" Style="{StaticResource DarkPillButton}" Content="Сбросить" Padding="14,0"/>
                        </StackPanel>
                        <TextBlock x:Name="SnapHoldHint" Text="Нажмите «Клавиша привязки», затем клавишу или комбинацию. Esc отменяет запись." TextWrapping="Wrap" Foreground="#FFAAAAAA"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="10">
                        <ToggleSwitch x:Name="ArrowKeysToggle" Header="Перемещать окна по зонам клавишами Win + ← / →" OnContent="Включено" OffContent="Выключено"/>
                        <TextBlock Text="Стрелки переключают активное окно между зонами выбранного монитора." TextWrapping="Wrap" Foreground="#FFBBBBBB"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Отображение зон" FontSize="18" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ZoneDisplayCombo" MinWidth="280" HorizontalAlignment="Left">
                            <ComboBox.Resources>
                                <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF2B2B2B"/>
                                <SolidColorBrush x:Key="AcrylicInAppFillColorDefaultBrush" Color="#FF2B2B2B"/>
                                <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#FF2B2B2B"/>
                                <SolidColorBrush x:Key="ComboBoxItemBackground" Color="#FF2B2B2B"/>
                                <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#FF383838"/>
                                <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#FF323232"/>
                                <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#FF333333"/>
                                <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#FF3D3D3D"/>
                                <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#FF383838"/>
                                <SolidColorBrush x:Key="ComboBoxItemBackgroundDisabled" Color="#FF2B2B2B"/>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="Невидимые области" Background="#FF2B2B2B"/>
                            <ComboBoxItem Content="Зоны поверх" Background="#FF2B2B2B"/>
                            <ComboBoxItem Content="Зоны на рабочем столе" Background="#FF2B2B2B"/>
                        </ComboBox>
                        <TextBlock x:Name="ZoneDisplayHint" TextWrapping="Wrap" Foreground="#FFBBBBBB"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Цвет зон" FontSize="18" FontWeight="SemiBold"/>
                        <ToggleSwitch x:Name="ZoneColorSystemToggle" Header="Как в Windows" OnContent="Системный" OffContent="Свой"/>
                        <TextBlock Text="Подсветка зон при перетаскивании. По умолчанию берётся цвет акцента Windows." TextWrapping="Wrap" Foreground="#FFBBBBBB"/>
                        <StackPanel x:Name="ZoneColorHost" Spacing="10"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCard}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Цвет акцентов приложения" FontSize="18" FontWeight="SemiBold"/>
                        <ToggleSwitch x:Name="AccentColorSystemToggle" Header="Как в Windows" OnContent="Системный" OffContent="Свой"/>
                        <TextBlock Text="Выделение макетов, переключатели и элементы редактора. По умолчанию совпадает с акцентом Windows. Нажмите образец или «Палитра», чтобы выбрать цвет кругом, RGB, HSV или HEX." TextWrapping="Wrap" Foreground="#FFBBBBBB"/>
                        <StackPanel x:Name="AccentColorHost" Spacing="10"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="ZoneEditorHost" Grid.Row="2" Margin="24,16,24,16" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <Grid x:Name="BottomBar" Grid.Row="3" Padding="24,12,24,16" ColumnSpacing="16" Background="{StaticResource GlassSoftBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterHint" Text="Удерживайте Shift при перетаскивании окна в зону" Foreground="#FFAAAAAA" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="CreateButton" Grid.Column="1" Style="{StaticResource DarkPillButton}" Content="+  Создать макет"/>
        </Grid>
    </Grid>
</Window>
