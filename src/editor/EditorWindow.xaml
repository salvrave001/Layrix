<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="LayrixEditor.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Layrix — Редактор зон">
    <Grid x:Name="Root" Background="#FF202020" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="TitleDrag" Background="Transparent" Margin="0,0,272,0">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8A9;" FontSize="14" Foreground="#FF4CC2FF"/>
                <TextBlock Text="Layrix" FontSize="12" Foreground="#FFE5E5E5" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Button x:Name="SettingsButton" Content="⚙  Настройки" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,144,0" Height="30" Padding="10,0"/>
        <Border x:Name="MonitorSection" Grid.Row="1" Background="#FF1D1D1D" BorderBrush="#FF2B2B2B" BorderThickness="0,0,0,1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <StackPanel x:Name="MonitorHost" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12"/>
                <TextBlock x:Name="MonitorDescription" FontSize="12" Foreground="#FFAAAAAA" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="Gallery" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,20,24,12">
            <StackPanel Spacing="14">
                <TextBlock Text="Шаблоны" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TemplateHost" Orientation="Horizontal" Spacing="10"/>
                </ScrollViewer>
                <TextBlock Text="Свои макеты" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,0"/>
                <Border x:Name="CustomEmpty" BorderBrush="#FF3B3B3B" BorderThickness="1" CornerRadius="4" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Ваше рабочее пространство" Foreground="#FFDDDDDD" FontSize="14"/>
                        <TextBlock Text="Создайте макет и расположите зоны так, как удобно вам." Foreground="#FF999999" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CustomHost" Orientation="Horizontal" Spacing="10"/>
                </ScrollViewer>
                <Expander Header="Настройки привязки" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
                    <StackPanel x:Name="ControlsHost" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="SpacingLabel" Text="Отступ" Foreground="White" VerticalAlignment="Center" MinWidth="180"/>
                            <TextBlock x:Name="SpacingValue" MinWidth="42" Foreground="#FFBBBBBB" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Цвет подсветки" Foreground="White" VerticalAlignment="Center" MinWidth="180"/>
                            <StackPanel x:Name="ColorHost" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Перехват Win + стрелки" Foreground="White" VerticalAlignment="Center" MinWidth="180"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Padding="32,24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="850" HorizontalAlignment="Stretch" Spacing="20">
                <Button x:Name="BackToLayouts" Content="←  К макетам зон" HorizontalAlignment="Left"/>
                <TextBlock Text="Настройки приложения" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Изменения применяются сразу." Foreground="#FFAAAAAA"/>
                <Border Background="#FF2B2B2B" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <ToggleSwitch x:Name="StartupToggle" Header="Запускать вместе с Windows" OnContent="Включён" OffContent="Выключен"/>
                        <TextBlock Text="Layrix будет запускаться при входе в вашу учётную запись и работать в трее. Окно редактора открываться не будет." TextWrapping="Wrap" Foreground="#FFBBBBBB"/>
                        <TextBlock x:Name="StartupStatus" TextWrapping="Wrap" Foreground="#FFAAAAAA" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Background="#FF2B2B2B" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <ToggleSwitch x:Name="ZonesToggle" Header="Привязка окон к зонам" OnContent="Включена" OffContent="Выключена"/>
                        <TextBlock Text="Удерживайте Shift при перетаскивании окна. Shift + Ctrl позволяет занять несколько зон." TextWrapping="Wrap" Foreground="#FFBBBBBB"/>
                    </StackPanel>
                </Border>
                <Border Background="#FF2B2B2B" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <ToggleSwitch x:Name="ArrowKeysToggle" Header="Перемещать окна по зонам клавишами Win + ← / →" OnContent="Включено" OffContent="Выключено"/>
                        <TextBlock Text="Стрелки переключают активное окно между зонами выбранного монитора." TextWrapping="Wrap" Foreground="#FFBBBBBB"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="ZoneEditorHost" Grid.Row="2" Margin="24,16,24,16" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <Grid x:Name="BottomBar" Grid.Row="3" Padding="24,12,24,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Удерживайте Shift при перетаскивании окна в зону" Foreground="#FFAAAAAA" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="CreateButton" Grid.Column="1" Height="36" Padding="16,0" CornerRadius="4" Content="+  Создать макет" Background="#FF0078D4" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
