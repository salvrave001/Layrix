<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="LayrixEditor.TemplateCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Card" Width="162" Height="140" Background="#FF333333" BorderBrush="#FF3A3A3A" BorderThickness="1" CornerRadius="4" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock x:Name="TitleText" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,24,0" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="EditButton" Width="24" Height="26" Padding="0" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Редактировать зоны на экране">
                    <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                </Button>
            </Grid>
            <Border Grid.Row="1" Margin="0,6,0,2" Background="#FF292929" CornerRadius="2">
                <Viewbox Stretch="Fill">
                    <Canvas x:Name="Preview" Width="148" Height="90"/>
                </Viewbox>
            </Border>
        </Grid>
    </Border>
</UserControl>
